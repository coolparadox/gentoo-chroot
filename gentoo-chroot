#!/usr/bin/env bash
set -euo pipefail
export CHROOT_DIR=$(mktemp -d)
export CHROOT_USER=${1:-$USER}
export CHROOT_ENV_WHITELIST='DISPLAY'
export CHROOT_MIRRORS='bin=o,dev=b,etc=o,home=o,media=o,lib=o,lib64=o,mnt=o,opt=o,proc=b,root=o,run=b,sbin=o,sys=b,usr=o,var=o,tmp=o'
$(dirname "$0")/in-chroot || :
rm -rf $CHROOT_DIR
