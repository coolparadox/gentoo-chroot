#!/usr/bin/env bash
#
# Run a command under a chroot environment.
#
# usage: in-chroot COMMAND [ARG...]
#
# Influential environment variables:
# - CHROOT_DIR where to setup the chroot
# - CHROOT_USER user under which the command is executed
# - CHROOT_ENV_WHITELIST comma separated enviroment variables to be transferred to the chroot
# - CHROOT_MIRRORS comma separated directories to be part of the chroot
#

set -euo pipefail

WHOAMI=$( basename "$0" )
OVERLAY_DIR=$( mktemp -d "/tmp/${WHOAMI}.XXXXXXXXXX")

CHROOT_CMD=$*

fail() {
    echo "${WHOAMI}: error: $*" >&2
    exit 1
}

warn() {
    echo "${WHOAMI}: warning: $*" >&2
}

IFS=',' read -a DIR_SPECS <<<$CHROOT_MIRRORS
declare -A DIRS
for DIR_SPEC in ${DIR_SPECS[*]} ; do
    DIRS[${DIR_SPEC%=*}]=${DIR_SPEC##*=}
done

make_overlay() {
    local DIR=$1
    mkdir -p $CHROOT_DIR/$DIR $OVERLAY_DIR/upper/$DIR $OVERLAY_DIR/work/$DIR
    chmod $(stat -c '%a' /$DIR) $OVERLAY_DIR/upper/$DIR
    chown $(stat -c '%u:%g' /$DIR) $OVERLAY_DIR/upper/$DIR
}

mount_overlay() {
    local DIR=$1
    mount -t overlay overlay -o volatile,lowerdir=/$DIR,upperdir=$OVERLAY_DIR/upper/$DIR,workdir=$OVERLAY_DIR/work/$DIR $CHROOT_DIR/$DIR
}

mount_bind() {
    local DIR=$1
    mkdir -p $CHROOT_DIR/$DIR && mount --rbind /$DIR $CHROOT_DIR/$DIR && mount --make-rslave $CHROOT_DIR/$DIR
}

mount_dirs() {
    for DIR in ${!DIRS[*]} ; do
        MOUNT_TYPE=${DIRS[$DIR]}
        case "$MOUNT_TYPE" in
            'o') make_overlay "$DIR" ;;
            'b') ;;
            'e') ;;
            *) fail "unknown mount type: $MOUNT_TYPE" ;;
        esac
    done
    touch $OVERLAY_DIR/upper$OVERLAY_DIR 2>/dev/null || :
    touch $OVERLAY_DIR/upper$CHROOT_DIR 2>/dev/null || :
    for DIR in ${!DIRS[*]} ; do
        MOUNT_TYPE=${DIRS[$DIR]}
        case "$MOUNT_TYPE" in
            'o') mount_overlay "$DIR" ;;
            'b') mount_bind "$DIR" ;;
            'e') mkdir -p "$CHROOT_DIR/$DIR" ;;
            *) fail "unknown mount type: $MOUNT_TYPE" ;;
        esac
    done
}

umount_dirs() {
    for DIR in ${!DIRS[*]} ; do
        mountpoint -q "$CHROOT_DIR/$DIR" || continue
        umount --lazy "$CHROOT_DIR/$DIR"
        rmdir "$CHROOT_DIR/$DIR"
    done
}

test -e "$CHROOT_DIR" && {
    rmdir "$CHROOT_DIR"
}
mkdir -p "$CHROOT_DIR"

mount_dirs

eval USER_DIR=~$CHROOT_USER
test -d $CHROOT_DIR/$USER_DIR && {
    cat >>$CHROOT_DIR/$USER_DIR/.bashrc <<__eod__
export PS1="($(basename $CHROOT_DIR)) \$PS1"
export XAUTHORITY=~/.Xauthority
__eod__
}

test "$CHROOT_USER" = 'root' -a -d $CHROOT_DIR/root || {
    cat >>$CHROOT_DIR/root/.bashrc <<__eod__
export PS1="($(basename $CHROOT_DIR)) \$PS1"
__eod__
}

set +e
if test -n "$CHROOT_CMD" ; then
    chroot $CHROOT_DIR /bin/su -l -w "$CHROOT_ENV_WHITELIST" -c "$CHROOT_CMD" $CHROOT_USER
else
    chroot $CHROOT_DIR /bin/su -l -w "$CHROOT_ENV_WHITELIST" $CHROOT_USER
fi
CHROOT_STATUS=$?
set -e

umount_dirs
rm -r "$OVERLAY_DIR"

find "$CHROOT_DIR" -mindepth 1 -maxdepth 1 | while read F ; do
    warn "leftovers under $CHROOT_DIR"
    break
done

exit $CHROOT_STATUS

